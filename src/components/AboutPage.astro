---
import SiteLayout from '../layouts/SiteLayout.astro';
import { localized, REPO } from '../site';
import type { Content } from '../i18n/en';

interface Props { t: Content }
const { t } = Astro.props;
const a = t.about;
const toc = [a.name, a.idea, a.how, a.principles, a.platforms, a.license];
---

<SiteLayout t={t} page="about" title={t.meta.aboutTitle} description={t.meta.aboutDesc} path="/about/">
	<section class="ink">
		<div class="wrap pagehead">
			<p class="kicker">{a.eyebrow}</p>
			<h1 class="page">{a.title}</h1>
			<p class="lede">{a.lede}</p>
		</div>
	</section>

	<div class="wrap essay">
		<aside class="toc" aria-label={a.tocTitle}>
			<b>{a.tocTitle}</b>
			{toc.map((s) => <a href={`#${s.id}`}>{s.toc}</a>)}
		</aside>

		<div>
			<section id={a.name.id}>
				<h2>{a.name.title}</h2>
				<blockquote><p class="q">{a.name.quote}</p></blockquote>
				{a.name.paras.map((p) => <p>{p}</p>)}
			</section>

			<section id={a.idea.id}>
				<h2>{a.idea.title}</h2>
				{a.idea.paras.map((p) => <p>{p}</p>)}
			</section>

			<section id={a.how.id}>
				<h2>{a.how.title}</h2>
				{a.how.paras.map((p) => <p>{p}</p>)}
				<ol class="pr">
					{a.how.steps.map(([title, text]) => <li><div><b>{title}</b><span>{text}</span></div></li>)}
				</ol>
			</section>

			<section id={a.principles.id}>
				<h2>{a.principles.title}</h2>
				<ol class="pr">
					{a.principles.items.map(([title, text]) => <li><div><b>{title}</b><span>{text}</span></div></li>)}
				</ol>
			</section>

			<section id={a.platforms.id}>
				<h2>{a.platforms.title}</h2>
				<p>{a.platforms.lead}</p>
				<table class="tbl">
					<tbody>
						{a.platforms.rows.map(([name, status, note, ok]) => (
							<tr><td>{name}</td><td><span class={ok ? 'tag' : 'tag warn'}>{status}</span> &nbsp;{note}</td></tr>
						))}
					</tbody>
				</table>
				<p style="margin-top:14px"><a href={localized(t.lang, '/developers/platforms/')}>{a.platforms.link}</a></p>
			</section>

			<section id={a.license.id}>
				<h2>{a.license.title}</h2>
				<p>{a.license.text} <a href={REPO} rel="noopener">{a.license.source}</a></p>
				<h3 class="minor">{a.license.creditsTitle}</h3>
				<table class="tbl">
					<tbody>{a.license.credits.map(([name, what]) => <tr><td>{name}</td><td>{what}</td></tr>)}</tbody>
				</table>
				<p style="margin-top:14px"><a href={localized(t.lang, '/developers/third-party-notices/')}>{a.license.creditsLink}</a></p>
			</section>
		</div>
	</div>
</SiteLayout>
