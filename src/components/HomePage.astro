---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import { href, localized, REPO } from '../site';
import { latestRelease } from '../lib/release';
import type { Content } from '../i18n/en';

interface Props { t: Content }
const { t } = Astro.props;
const h = t.home;
const linkTo = (target: string) => (target === 'repo' ? REPO : localized(t.lang, target));
const release = await latestRelease();
---

<SiteLayout t={t} page="home" title={t.meta.homeTitle} description={t.meta.homeDesc} path="/">
	<section class="wrap hero">
		<div class="hero-text">
			<a class="status" href={localized(t.lang, '/download/')}>
				<span class="dot"></span>{release ? `v${release.version} · ${h.released} ${release.published}` : h.status}
			</a>
			<h1 class="display">{h.titleA}<br /><b>{h.titleB}</b></h1>
			<p class="lede">{h.lede}</p>
			<div class="actions">
				<a class="btn primary" href={localized(t.lang, '/download/')}><Icon name="download" />{h.download}</a>
				<a class="btn line" href={REPO} rel="noopener"><Icon name="code" />{h.github}</a>
			</div>
			<p class="meta">{h.meta.map((m, i) => <>{i > 0 && <span class="sep">/</span>}{m}</>)}</p>
		</div>
		{/* Self-hosted, no third-party player. It plays muted and looping once the page is visible; with reduced motion or
		    save data, or without JavaScript, the poster and native controls stay and nothing is downloaded until play. */}
		<figure class="intro">
			<video controls muted loop playsinline preload="none" poster={href('/video/intro-poster.jpg')} aria-label={h.videoLabel} width="1920" height="1080">
				<source src={href(h.video)} type="video/mp4" />
			</video>
			<button class="sound" type="button" aria-pressed="false" hidden>
				<span class="off"><Icon name="volume" />{h.soundOn}</span>
				<span class="on"><Icon name="mute" />{h.soundOff}</span>
			</button>
		</figure>
	</section>

	<section class="s wrap">
		<p class="kicker">{h.featuresKicker}</p>
		<h2 class="h2">{h.featuresTitle}</h2>
		<div class="feats">
			{h.features.map((f) => (
				<div class="feat">
					<span class="glyph"><Icon name={f.icon} /></span>
					<h3>{f.title}{f.tag && <span class="tag">{f.tag}</span>}</h3>
					<p>{f.text}</p>
				</div>
			))}
		</div>
	</section>

	<section class="s wrap">
		<p class="kicker">{h.enginesKicker}</p>
		<h2 class="h2">{h.enginesTitle}</h2>
		<div class="engines">
			<div class="panel local">
				<h3><Icon name="lock" />{h.localTitle}</h3>
				<ul class="chips">{h.localItems.map((x) => <li>{x}</li>)}</ul>
				<p>{h.localNote}</p>
			</div>
			<div class="panel">
				<h3><Icon name="cloud" />{h.cloudTitle}</h3>
				<ul class="chips">{h.cloudItems.map((x) => <li>{x}</li>)}</ul>
				<p>{h.cloudNote}</p>
			</div>
		</div>
		<p class="after">{h.enginesNote} <a href={localized(t.lang, '/privacy/')}>{h.privacyLink}<Icon name="arrow" /></a></p>
	</section>

	<section class="band">
		<div class="wrap os">
			<div>
				<p class="kicker">{h.openKicker}</p>
				<h2 class="h2">{h.openTitle}</h2>
				<p class="sub">{h.openText}</p>
				<div class="oslinks">
					{h.openLinks.map((l) => (
						<a class="oslink" href={linkTo(l.href)} rel={l.href === 'repo' ? 'noopener' : undefined}>
							<b><Icon name={l.icon} />{l.title}</b>
							<span>{l.text}</span>
						</a>
					))}
				</div>
			</div>
			<div class="term" role="group" aria-label={h.buildLabel}>
				<div class="tb"><i></i><i></i><i></i><em>{h.buildLabel}</em></div>
				<pre><code>{h.buildCode.split('\n').map((line) => <span class="ln"><span class="prompt">$</span>{line}</span>)}</code></pre>
			</div>
		</div>
	</section>
</SiteLayout>

<script>
	const video = document.querySelector<HTMLVideoElement>('.intro video');
	const sound = document.querySelector<HTMLButtonElement>('.intro .sound');
	const calm = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData === true;
	if (video && sound && !calm) {
		// Browsers refuse to start a video in a hidden tab, so wait until the page is visible. If playing is refused anyway,
		// the native controls stay.
		const start = () => video.play().then(() => { video.controls = false; sound.hidden = false; }).catch(() => {});
		if (document.hidden) document.addEventListener('visibilitychange', start, { once: true });
		else start();
		sound.addEventListener('click', () => {
			video.muted = !video.muted;
			if (!video.muted && video.paused) video.play();
			sound.setAttribute('aria-pressed', String(!video.muted));
		});
	}
</script>
