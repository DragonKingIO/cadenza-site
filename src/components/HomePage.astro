---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import Seal from './Seal.astro';
import { href, localized } from '../site';
import type { Content } from '../i18n/en';

interface Props { t: Content }
const { t } = Astro.props;
const h = t.home;
---

<SiteLayout t={t} page="home" title={t.meta.homeTitle} description={t.meta.homeDesc} path="/">
	<section class="hero wrap">
		<p class="eyebrow">{h.eyebrow}</p>
		<h1 class="huge">{h.titleA}{t.lang === 'zh' ? '' : ' '}<b>{h.titleB}</b></h1>
		<p class="lede">{h.lede}</p>
		<div class="actions" style="justify-content:center">
			<a class="btn primary" href={localized(t.lang, '/download/')}><Icon name="download" />{h.download}</a>
			<a class="btn line" href={localized(t.lang, '/getting-started/')}>{h.docs}<Icon name="arrow" /></a>
		</div>
		<p class="small" style="margin:18px auto 0;max-width:36em">{h.early}</p>
		<div class="stage">
			<img class="enso" src={href('/art/enso.svg')} alt="" width="460" height="460" />
			{/* Self-hosted, no third-party player. Plays muted and looping; nothing loads for visitors who prefer reduced
			    motion or save data, and without JavaScript the native controls stay. */}
			<figure class="intro">
				<video controls muted loop playsinline preload="none" poster={href('/video/intro-poster.jpg')} aria-label={h.videoLabel} width="1920" height="1080">
					<source src={href(h.video)} type="video/mp4" />
				</video>
				<button class="sound" type="button" aria-pressed="false" hidden>
					<span class="off"><Icon name="volume" />{h.soundOn}</span>
					<span class="on"><Icon name="mute" />{h.soundOff}</span>
				</button>
			</figure>
		</div>
	</section>

	<section class="s wrap">
		<h2 class="title center">{h.featuresTitle}</h2>
		<div class="features">
			{h.features.map((f) => (
				<div class="feature">
					<span class="glyph"><Icon name={f.icon} /></span>
					<h3>{f.title}{f.tag && <span class="tag">{f.tag}</span>}</h3>
					<p>{f.text}</p>
					{f.link && <a class="more" href={localized(t.lang, f.link.path)}>{f.link.text}<Icon name="arrow" /></a>}
				</div>
			))}
		</div>
	</section>

	<section class="closing wrap">
		<Seal large />
		<h2 class="title">{h.closingTitle}</h2>
		<p class="lede">{h.closingText}</p>
		<div class="actions" style="justify-content:center">
			<a class="btn primary" href={localized(t.lang, '/download/')}><Icon name="download" />{h.download}</a>
			<a class="btn line" href={localized(t.lang, '/about/')}>{t.nav.about}<Icon name="arrow" /></a>
		</div>
	</section>
</SiteLayout>

<script>
	const video = document.querySelector<HTMLVideoElement>('.intro video');
	const sound = document.querySelector<HTMLButtonElement>('.intro .sound');
	const calm = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData === true;
	if (video && sound && !calm) {
		// Browsers refuse to start a video in a hidden tab, so wait until the page is visible. If playing is refused anyway,
		// the native controls stay.
		const start = () => video.play().then(() => { video.controls = false; sound.hidden = false; }).catch(() => {});
		if (document.hidden) document.addEventListener('visibilitychange', start, { once: true });
		else start();
		sound.addEventListener('click', () => {
			video.muted = !video.muted;
			if (!video.muted && video.paused) video.play();
			sound.setAttribute('aria-pressed', String(!video.muted));
		});
	}
</script>
