---
// The brand mark drawn inline so its colours follow the theme (--logo and --logo-cut in site.css).
import logo from '../assets/logo.svg?raw';
interface Props { size?: number }
const { size = 28 } = Astro.props;
const marks = logo.replace(/<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<title[^>]*>.*?<\/title>/, '')
	.replace('#185C53', 'var(--logo)').replace('#F5F1E8', 'var(--logo-cut)');
---

<svg class="logo" viewBox="0 0 1024 1024" width={size} height={size} aria-hidden="true" set:html={marks} />
