---
// The vermilion seal: the brand's speech bubble, white on red, slightly tilted like a stamp.
import logo from '../assets/logo.svg?raw';
interface Props { large?: boolean }
const { large = false } = Astro.props;
// Inner marks only: drop the outer <svg> wrapper and recolor (bubble white, cursor red).
const inner = logo.replace(/<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<title[^>]*>.*?<\/title>/, '').replace('#185C53', '#ffffff').replace('#F5F1E8', 'var(--seal)');
---

<span class:list={['seal', { 's-lg': large }]} aria-hidden="true"><svg viewBox="0 0 1024 1024" set:html={inner} /></span>
